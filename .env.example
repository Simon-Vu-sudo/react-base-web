# Absolute URL of the API. Bearer tokens are attached by application code
# (not the browser), so same-origin is no longer required for cookies —
# point this straight at the mock API for manual testing.
VITE_API_URL=http://localhost:8080
VITE_MQTT_URL=ws://localhost:9001/mqtt
# 'real' | 'fake' — 'fake' swaps in the in-memory MQTT transport for E2E
VITE_MQTT_TRANSPORT=real
