# Absolute URL of your API. Bearer tokens are attached by application code
# rather than by the browser, so the API does not need to be same-origin.
VITE_API_URL=http://localhost:8080

VITE_MQTT_URL=ws://localhost:9001/mqtt
# 'real' | 'fake' — 'fake' swaps in the in-memory MQTT transport for E2E
VITE_MQTT_TRANSPORT=real

# 'real' | 'fake' — 'fake' swaps apiFetch's `fetch` for an in-app, in-memory
# transport shim (src/dev/fakeApi.ts) that answers from seeded data, so the
# app runs with no backend at all. See README "Running without a backend".
VITE_API_TRANSPORT=real

# Access-token lifetime in seconds, only read when VITE_API_TRANSPORT=fake.
# Defaults to 900 (15 minutes). Set it to something small, e.g. 30, to make
# the reactive-refresh interceptor visibly fire while clicking around.
# VITE_FAKE_ACCESS_TTL_SECONDS=900
